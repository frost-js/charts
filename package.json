{
    "name": "@fr0st/charts",
    "version": "1.0.1",
    "private": false,
    "description": "Standalone responsive canvas bar, line, area, pie, donut, scatter, polar area, and radar charts.",
    "keywords": [
        "charts",
        "canvas",
        "bar",
        "line",
        "area",
        "donut",
        "scatter",
        "pie",
        "polar",
        "radar",
        "frost"
    ],
    "homepage": "https://github.com/frost-js/charts",
    "bugs": {
        "url": "https://github.com/frost-js/charts/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frost-js/charts.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/frost-charts.esm.js",
            "default": "./dist/frost-charts.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/frost-charts.esm.js",
    "jsdelivr": "./dist/frost-charts.min.js",
    "unpkg": "./dist/frost-charts.min.js",
    "module": "./dist/frost-charts.esm.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode umd",
        "lint": "eslint",
        "test": "npm run build && npm run test:browser",
        "test:browser": "playwright test --forbid-only",
        "test:coverage": "playwright test --config=playwright.coverage.config.js --forbid-only",
        "test:headed": "playwright test --forbid-only --headed",
        "test:ui": "playwright test --ui"
    },
    "browserslist": [
        "baseline newly available"
    ],
    "devDependencies": {
        "@fr0st/eslint-config": "^6.0.1",
        "@playwright/test": "^1.64.1",
        "eslint": "^10.13.0",
        "monocart-reporter": "2.14.0",
        "vite": "^8.3.5"
    },
    "overrides": {
        "monocart-reporter": {
            "monocart-coverage-reports": "2.13.0"
        }
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
